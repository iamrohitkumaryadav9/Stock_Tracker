# Copy to .env.local and fill in. Never commit real values.
MONGODB_URI=mongodb://127.0.0.1:27017/quantis
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional
GEMINI_API_KEY=
FINNHUB_API_KEY=
NEXT_PUBLIC_FINNHUB_API_KEY=
# Required by SEC if you use the EDGAR loader: "YourApp your-contact@example.com"
SEC_USER_AGENT=
# Optional HTTP service returning {mean, sigma} for foundation-model forecasts
FOUNDATION_MODEL_URL=
